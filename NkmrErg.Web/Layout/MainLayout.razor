@inherits LayoutComponentBase

<div class="drawer drawer-end">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" @bind="isDrawerOpen" />
    <div class="drawer-content flex flex-col h-screen overflow-hidden bg-base-200">
        <!-- Top Navbar -->
        <header class="navbar bg-primary text-primary-content shadow-lg z-20 flex-none px-4">
            <div class="navbar-start flex items-center gap-3">
                <a href="" class="flex items-center gap-2.5 normal-case font-black tracking-widest text-lg md:text-xl">
                    <div class="h-9 w-9 rounded-xl bg-white/20 backdrop-blur flex items-center justify-center font-black text-sm tracking-tighter text-white shadow">
                        NK
                    </div>
                    <span>NkmrErg</span>
                </a>
            </div>
            <div class="navbar-center hidden md:flex">
                <span class="text-xs uppercase font-semibold tracking-widest text-primary-content/80 px-3 py-1 rounded-full bg-white/10">
                    Cockpit Entraînement FTMS
                </span>
            </div>
            <div class="navbar-end">
                <label for="main-drawer" class="btn btn-ghost btn-circle drawer-button" title="Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </label>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow overflow-y-auto p-4 md:p-8 pb-24">
            @Body
        </main>

        <!-- Bottom Navigation (Mobile & Tablet) -->
        <nav class="btm-nav z-40 bg-base-100 border-t border-base-300">
            <NavLink href="" Match="NavLinkMatch.All" class="text-primary" ActiveClass="active bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="btm-nav-label text-xs">Accueil</span>
            </NavLink>
            <NavLink href="workouts" class="text-primary" ActiveClass="active bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span class="btm-nav-label text-xs">Workouts</span>
            </NavLink>
            <NavLink href="freeride" class="text-primary" ActiveClass="active bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="btm-nav-label text-xs">Mode Libre</span>
            </NavLink>
            <NavLink href="remote" class="text-primary" ActiveClass="active bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span class="btm-nav-label text-xs">Télécommande</span>
            </NavLink>
            <NavLink href="parametres" class="text-primary" ActiveClass="active bg-primary/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="btm-nav-label text-xs">Réglages</span>
            </NavLink>
        </nav>
    </div>

    <!-- Sidebar (Drawer Side à droite) -->
    <div class="drawer-side z-50">
        <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <div class="p-6 w-80 min-h-full bg-base-100 text-base-content flex flex-col justify-between border-l border-base-300 shadow-2xl">
            <div>
                <!-- Entête du Menu -->
                <div class="flex items-center justify-between pb-5 mb-5 border-b border-base-300">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center font-black text-sm tracking-tighter text-white shadow-lg shadow-blue-500/25">
                            NK
                        </div>
                        <div>
                            <div class="font-black text-lg tracking-wider text-primary">NkmrErg</div>
                            <div class="text-xs opacity-60">Cockpit d'entraînement</div>
                        </div>
                    </div>
                    <label for="main-drawer" class="btn btn-ghost btn-sm btn-circle" @onclick="CloseDrawer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </label>
                </div>

                <!-- Liste des liens avec icônes pour TOUS les éléments -->
                <ul class="menu p-0 gap-2 text-base">
                    <li>
                        <NavLink href="" Match="NavLinkMatch.All" @onclick="CloseDrawer" class="flex items-center gap-3.5 py-3 px-3.5 rounded-xl font-medium hover:bg-base-200 transition-colors" ActiveClass="active bg-primary text-primary-content font-bold">
                            <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                            </div>
                            <span>Accueil</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="workouts" @onclick="CloseDrawer" class="flex items-center gap-3.5 py-3 px-3.5 rounded-xl font-medium hover:bg-base-200 transition-colors" ActiveClass="active bg-primary text-primary-content font-bold">
                            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                            </div>
                            <span>Mes Entraînements</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="freeride" @onclick="CloseDrawer" class="flex items-center gap-3.5 py-3 px-3.5 rounded-xl font-medium hover:bg-base-200 transition-colors" ActiveClass="active bg-primary text-primary-content font-bold">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/10 flex items-center justify-center text-orange-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                            <span>Mode Libre (ERG)</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="remote" @onclick="CloseDrawer" class="flex items-center gap-3.5 py-3 px-3.5 rounded-xl font-medium hover:bg-base-200 transition-colors" ActiveClass="active bg-primary text-primary-content font-bold">
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <span>Télécommande PC</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="parametres" @onclick="CloseDrawer" class="flex items-center gap-3.5 py-3 px-3.5 rounded-xl font-medium hover:bg-base-200 transition-colors" ActiveClass="active bg-primary text-primary-content font-bold">
                            <div class="w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <span>Paramètres</span>
                        </NavLink>
                    </li>
                </ul>
            </div>

            <!-- Bas du Menu avec lien Portail NoKeMaRe -->
            <div class="pt-5 border-t border-base-300 space-y-3">
                <a href="https://nokemare.com" target="_blank" class="btn btn-outline btn-sm w-full gap-2 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Portail NoKeMaRe
                </a>
                <div class="text-center text-xs opacity-50">
                    NkmrErg • v1.0.0
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isDrawerOpen = false;

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }
}
